  "duration": 12,
  "weeklyFrequency": 3,
  "difficulty": "intermediate",
  "goal": "fat-loss-muscle-gain",
  "targetUser": {
    "level": "intermediate-returning",
    "notes": "Returning from break, needs ramp-up period"
  },
  "description": "12-week full-body recomp program focusing on fat loss and muscle gain. 3 workouts per week, progressive overload with proper periodization.",
  
  "phases": [
    {
      "phaseId": "phase-1",
      "phaseName": "Re-adaptation",
      "weeks": [1, 2],
      "intensityPercent": 70,
      "volumeLevel": "low",
      "weeklySetCount": 38,
      "rpe": "6-7",
      "rir": "3-4",
      "notes": "Focus on form, controlled tempo, getting back into rhythm. No weight increases.",
      "goals": ["Perfect technique", "Build work capacity", "Prepare joints and tendons"]
    },
    {
      "phaseId": "phase-2",
      "phaseName": "Build",
      "weeks": [3, 4],
      "intensityPercent": 75,
      "volumeLevel": "moderate",
      "weeklySetCount": 42,
      "rpe": "7-8",
      "rir": "2-3",
      "notes": "Progressive overload begins. Add weight when hitting top of rep range.",
      "goals": ["Begin progressive overload", "Track all weights", "Build strength base"]
    },
    {
      "phaseId": "phase-3",
      "phaseName": "Progressive Overload",
      "weeks": [5, 6, 7, 8],
      "intensityPercent": 82,
      "volumeLevel": "moderate-high",
      "weeklySetCount": 45,
      "rpe": "8",
      "rir": "2",
      "notes": "Increase volume on accessories. Optional finisher 1x/week (Day A only).",
      "goals": ["Consistent strength gains", "Add accessory volume", "Optional conditioning"]
    },
    {
      "phaseId": "phase-4",
      "phaseName": "Deload",
      "weeks": [9],
      "intensityPercent": 60,
      "volumeLevel": "low",
      "weeklySetCount": 20,
      "rpe": "5-6",
      "rir": "4+",
      "notes": "Active recovery week. Reduce weight by 40%, keep exercises. Skip core and finishers.",
      "goals": ["Full recovery", "Joint decompression", "Prepare for peak"]
    },
    {
      "phaseId": "phase-5",
      "phaseName": "Peak",
      "weeks": [10, 11, 12],
      "intensityPercent": 88,
      "volumeLevel": "high",
      "weeklySetCount": 48,
      "rpe": "8-9",
      "rir": "1-2",
      "notes": "Push for PRs. Add finishers 2x/week (Day A and C). All accessories at 3 sets.",
      "goals": ["New personal records", "Maximum effort", "Complete transformation"]
    }
  ],

